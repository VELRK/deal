Options -MultiViews
DirectoryIndex index.php
RewriteEngine On
RewriteBase /admin/

# Existing files (none expected) — otherwise every path boots CI
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /admin/login → /admin/index.php (REQUEST_URI stays /admin/login)
RewriteRule ^ index.php [L]

# Apache 2.4 fallback when RewriteRule is ignored
FallbackResource /admin/index.php
