Options -MultiViews
DirectoryIndex index.php index.html

RewriteEngine On
RewriteBase /

# Hide index.php in the browser: /index.php/admin/login → /admin/login
RewriteCond %{THE_REQUEST} \s/+index\.php/([^\s?]*) [NC]
RewriteRule ^index\.php/(.*)$ /$1 [R=301,L,QSA]

# Pass Authorization to PHP (Apache often strips it otherwise → JWT/royalty fail)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── CORS ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Requested-With, X-Session-ID"
</IfModule>

# Return 200 immediately for preflight OPTIONS requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=200,L]

# Allow direct access to uploads directory and all files in it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/ - [L]

# Handle service worker requests
RewriteRule ^firebase-messaging-sw\.js$ firebase-messaging-sw.php [L]

# Set proper headers for service worker
<Files "firebase-messaging-sw.php">
    Header set Content-Type "application/javascript"
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</Files>

# Legacy path redirects (ilf/ecomm → deal)
RewriteRule ^ilf/frontend/assets/(.*)$ frontend/assets/$1 [R=301,L]
RewriteRule ^ilf/assets/(.*)$ assets/$1 [R=301,L]
RewriteRule ^ecomm/(.*)$ $1 [R=301,L]

# Canonical admin URL — legacy /shopkart panel paths → /admin (internal rewrite)
RewriteRule ^shopkart/?$ admin/ [L]
RewriteRule ^shopkart/(.+)$ admin/$1 [L]

# Always fetch fresh SPA shell after deploys
<Files "frontend/index.html">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</Files>

# Serve static dirs / existing files directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(frontend|assets|images|css|js|fonts|webfonts|uploads)/ - [L]

# ── CodeIgniter (prefer PATH_INFO; query-string fallback) ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^shopkart-api(?:/(.*))?$ index.php/shopkart-api/$1 [L,QSA]

RewriteRule ^admin/?$ index.php/admin [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.+)$ index.php/admin/$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^invoice/(.+)$ index.php/invoice/$1 [L,QSA]

# SPA: root → frontend shell; other app routes → React
RewriteRule ^$ frontend/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!shopkart-api|shopkart|admin|invoice|uploads|index\.php).*$ frontend/index.html [L]

# Apache 2.4 / shared hosting: route missing paths into CI
FallbackResource /index.php
ErrorDocument 404 /index.php
